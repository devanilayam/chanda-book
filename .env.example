# Supabase project credentials, read by @nuxtjs/supabase.
# Find both under Project Settings -> API in the Supabase dashboard.
# Copy this file to `.env` and fill it in; `.env` is gitignored.

SUPABASE_URL="https://your-project-ref.supabase.co"

# The publishable "anon" key. Safe to ship to the browser — row-level security
# is what protects the data, not the secrecy of this key.
SUPABASE_KEY="your-anon-key"
